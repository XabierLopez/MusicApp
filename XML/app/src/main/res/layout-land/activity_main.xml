    <SeekBar
        android:id="@+id/denboraBarra"
        android:layout_width="171dp"
        android:layout_height="25dp"
        android:progress="25"
        android:progressDrawable="@drawable/barra_pertsonalizatua"
        android:progressTint="#000000"
        android:scaleX="2"
        android:scaleY="1.6"
        android:thumb="@drawable/thumb_pertsonalizatua"
        android:thumbTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/playPause"
        app:layout_constraintEnd_toStartOf="@+id/faltaDenDenbora"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/pasatutakoDenbora"
        app:layout_constraintTop_toBottomOf="@+id/taldea" />

    <SeekBar
        android:id="@+id/bolumenBarra"
        android:layout_width="171dp"
        android:layout_height="25dp"
        android:progressDrawable="@drawable/barra_pertsonalizatua"
        android:progressTint="@color/black"
        android:rotation="-90"
        android:scaleX="2"
        android:scaleY="1.6"
        android:thumb="@drawable/thumb_pertsonalizatua"
        android:thumbTint="@color/white"
        android:progress="70"
        app:layout_constraintBottom_toBottomOf="@+id/cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/denboraBarra"
        app:layout_constraintTop_toTopOf="@+id/cover" />

    <ImageView
        android:id="@+id/aurrekoa"
        android:layout_width="72dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toTopOf="@+id/letra"
        app:layout_constraintEnd_toStartOf="@+id/playPause"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/linearLayout"
        app:layout_constraintTop_toBottomOf="@+id/denboraBarra"
        app:srcCompat="@drawable/aurrekoa"
        app:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/letra"
        android:layout_width="72dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/lista"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/linearLayout"
        app:layout_constraintTop_toBottomOf="@+id/aurrekoa"
        app:srcCompat="@drawable/letra"
        app:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/playPause"
        android:layout_width="72dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toTopOf="@+id/lista"
        app:layout_constraintEnd_toStartOf="@+id/hurrengoa"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/aurrekoa"
        app:layout_constraintTop_toBottomOf="@+id/denboraBarra"
        app:srcCompat="@drawable/play"
        app:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/hurrengoa"
        android:layout_width="72dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toTopOf="@+id/partekatu"
        app:layout_constraintEnd_toStartOf="@+id/bolumenBarra"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/playPause"
        app:layout_constraintTop_toBottomOf="@+id/denboraBarra"
        app:srcCompat="@drawable/hurrengoa"
        app:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/partekatu"
        android:layout_width="72dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/bolumenBarra"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/lista"
        app:layout_constraintTop_toBottomOf="@+id/hurrengoa"
        app:srcCompat="@drawable/partekatu"
        app:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/lista"
        android:layout_width="72dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/partekatu"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/letra"
        app:layout_constraintTop_toBottomOf="@+id/playPause"
        app:srcCompat="@drawable/lista"
        app:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/soinua"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:clickable="false"
        app:layout_constraintBottom_toTopOf="@+id/cover"
        app:layout_constraintEnd_toEndOf="@+id/bolumenBarra"
        app:layout_constraintStart_toStartOf="@+id/bolumenBarra"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/soinua"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/pasatutakoDenbora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:25"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/denboraBarra"
        app:layout_constraintEnd_toStartOf="@+id/denboraBarra"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/linearLayout"
        app:layout_constraintTop_toTopOf="@+id/denboraBarra" />

    <TextView
        android:id="@+id/faltaDenDenbora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1:15"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/denboraBarra"
        app:layout_constraintEnd_toStartOf="@id/bolumenBarra"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/denboraBarra"
        app:layout_constraintTop_toTopOf="@+id/denboraBarra" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="1dp"
        android:layout_height="446dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"></LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>